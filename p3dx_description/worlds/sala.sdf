<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="sala_5x5">
    
    <!-- Plugins obrigatórios do novo Gazebo para a física e interface funcionarem -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>

    <!-- Iluminação (Sol) -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Chão -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- As 4 paredes -->
    <model name="paredes">
      <static>true</static>
      
      <!-- Parede Norte (Y positivo) -->
      <link name="parede_norte">
        <pose>0 2.5 1 0 0 0</pose>
        <collision name="col"><geometry><box><size>5.15 0.15 2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>5.15 0.15 2</size></box></geometry></visual>
      </link>
      
      <!-- Parede Sul (Y negativo) -->
      <link name="parede_sul">
        <pose>0 -2.5 1 0 0 0</pose>
        <collision name="col"><geometry><box><size>5.15 0.15 2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>5.15 0.15 2</size></box></geometry></visual>
      </link>
      
      <!-- Parede Leste (X positivo) -->
      <link name="parede_leste">
        <pose>2.5 0 1 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.15 5 2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.15 5 2</size></box></geometry></visual>
      </link>
      
      <!-- Parede Oeste (X negativo) -->
      <link name="parede_oeste">
        <pose>-2.5 0 1 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.15 5 2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.15 5 2</size></box></geometry></visual>
      </link>
    </model>

  </world>
</sdf>
